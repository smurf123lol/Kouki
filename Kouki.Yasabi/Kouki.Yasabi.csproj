<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Kouki.Yasabi</AssemblyName>
    <RootNamespace>Kouki.Yasabi</RootNamespace>
    <PackageId>Kouki.Yasabi</PackageId>
    <Description>Понимание естественного языка: классификаторы интентов и маршрутизация текста в команды Kouki (муси Ясаби).</Description>
    <PackageTags>kouki;nlu;intent;router;mushi</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kouki.Kagedama.Contracts\Kouki.Kagedama.Contracts.csproj" />
    <ProjectReference Include="..\Kouki.Mugura\Kouki.Mugura.csproj" />
    <ProjectReference Include="..\Shimi\Shimi.csproj" />
  </ItemGroup>

</Project>
