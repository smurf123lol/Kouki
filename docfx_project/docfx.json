{
  "metadata": [
    {
      "src": [
        { "files": ["Shimi/*.csproj", "Kouki.Mugura/*.csproj"], "src": "../" }
      ],
      "dest": "api"
    },
    {
      "src": [
        { "files": ["Kagedama.api/*.csproj", "Kagedama.vs/*.csproj"], "src": "../" }
      ],
      "dest": "examples/kagedama/api"
    }
  ],
  "build": {
    "content": [
      { "files": ["api/**/*.yml", "api/**/toc.yml"] },
      { "files": ["docs/**/*.md", "docs/**/toc.yml"] },
      { "files": ["examples/kagedama/**/*.md", "examples/kagedama/**/toc.yml", "examples/kagedama/api/**/*.yml"] },
      { "files": ["*.md", "toc.yml"] }
    ],
    "dest": "_site",
    "template": ["default", "modern"],
    "fileMetadata": {
      "pdf": {
        "api/toc.yml": true,
        "examples/kagedama/api/toc.yml": true
      },
      "pdfFileName": {
        "api/toc.yml":"kouki-api.pdf",
        "examples/kagedama/api/toc.yml" : "kagedama-api.pdf"
      }
    }
  }
}
