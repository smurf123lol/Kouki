# Сетевой диск Kouki (Samba). Кладётся в /etc/samba/smb.conf.
#
# Установка: см. README.md рядом. Пароль SMB задаётся отдельно от системного:
#   sudo smbpasswd -a <пользователь>   (и -e, если учётка была отключена)
#
# Почему так, а не «как в интернете по умолчанию»:
#   * server min protocol = SMB2_10 — SMB1 выключен (он дырявый и не нужен ни
#     Windows 10+, ни macOS, ни Linux);
#   * map to guest = never — «гостевой» доступ, который открывается одной
#     строкой, отдаёт каталог любому в сети; анонимного входа здесь нет;
#   * печать выключена: сервер файлов не должен поднимать spoolss, за который
#     потом прилетают CVE;
#   * force group + setgid каталога дают общий доступ для группы, а не «у всех
#     права 777».

[global]
   workgroup = WORKGROUP
   server string = kouki files
   server role = standalone server
   server min protocol = SMB2_10
   map to guest = never
   usershare allow guests = no
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file
   restrict anonymous = 2

   # Список компьютеров сети (browse list) — не наша работа, и `os level` мы не
   # трогаем: у Samba он по умолчанию 20, то есть «обычный участник». Явно
   # выключаем участие в выборах браузера — в домашней сети оно только путает
   # список «Сеть» в проводнике Windows, а доступ к шаре от этого не зависит.
   # Подключаются по адресу `\\<ip>\files` или по имени хоста.
   local master = no
   domain master = no
   preferred master = no
   dns proxy = no

   # `interfaces` / `bind interfaces only` намеренно НЕ заданы. Смысл этих
   # строк — ограничить smbd конкретными сетевыми картами, а не «пустить только
   # своих»: наружу трафик всё равно уходит через роутер. На этой машине
   # единственный рабочий канал — USB-Wi-Fi (имя вида `wlx<mac>`, меняется при
   # переподключении адаптера), а проводной `enp4s0` лежит; привязка к имени
   # интерфейса молча оставила бы SMB недоступным. Если когда-нибудь понадобится
   # привязка, сначала посмотрите фактические имена:
   #   ip -br a
   # и только потом:
   #   interfaces = <iface>
   #   bind interfaces only = yes

[files]
   comment = Kouki files
   path = /srv/files
   browseable = yes
   read only = no
   valid users = smurf123lol
   force group = smurf123lol
   create mask = 0664
   directory mask = 2775
