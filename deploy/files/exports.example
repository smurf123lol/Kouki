# Экспорт NFS для тех же файлов, что отдаёт Samba.
# Кладётся в /etc/exports, затем: sudo exportfs -ra
#
# Ограничения по сети — обязательны: без них каталог открыт любому, кто
# достучится до сервера. Сеть подставьте свою.
#
# rw          — чтение и запись;
# sync        — подтверждать запись после сброса на диск (медленнее, но без
#               «файл есть, а данных нет» после внезапного выключения);
# no_subtree_check — не проверять каждый подкаталог по inode: надёжнее при
#               переименованиях, которыми пользуется Samba.
#
# root_squash (по умолчанию) означает, что root клиента приезжает как nobody:
# на сервере файлы нельзя писать «от рута», только под своим uid. Это защита,
# а не ошибка: если root клиента получит запись, любой его процесс сможет
# менять чужие файлы.

/srv/files 192.168.1.0/24(rw,sync,no_subtree_check)
