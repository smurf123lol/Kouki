# Настройки резервного копирования Kouki. Установщик не создаёт этот файл:
# бэкап — решение администратора, а не следствие установки. Создайте вручную:
#   sudo install -o root -g kouki -m 640 deploy/backup.env.example /etc/kouki/backup.env

# Куда складывать снимки. Не на тот же диск, что /var/lib/kouki.
KOUKI_BACKUP_DIR=/var/backups/kouki

# Что бэкапить.
KOUKI_DATABASE_PATH=/var/lib/kouki/db/kouki.sqlite
KOUKI_AUDIO_DIR=/var/lib/kouki/audio

# Сколько дней хранить снимки базы и файлы аудио.
KOUKI_BACKUP_RETENTION_DAYS=14
