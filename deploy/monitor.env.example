# Алерты сторожа Kouki (T53). Копируется установщиком в /etc/kouki/monitor.env.
# Без этого файла сторож работает и пишет только в журнал (journalctl -u kouki-monitor).
#
# Токен бота и чат — только для отправки сообщений. Права: 640 root:kouki,
# потому что в файле секрет.

# Токен Telegram-бота (тот же, что у kouki-bot, либо отдельный «сервисный»).
# KOUKI_ALERT_TOKEN=123456789:AA...

# Кому писать: chat_id пользователя или группы (узнать: написать боту и посмотреть
# в журнале kouki-bot строку «чат …», либо через getUpdates).
# KOUKI_ALERT_CHAT=123456789

# Как часто напоминать, пока проблема не ушла (секунды, по умолчанию 3600).
# KOUKI_MONITOR_REMIND_SECONDS=3600

# Каталог состояния — по умолчанию /var/lib/kouki/monitor.
# KOUKI_MONITOR_STATE=/var/lib/kouki/monitor
