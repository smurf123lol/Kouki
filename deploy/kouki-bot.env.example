# Настройки Telegram-бота Kouki. Установщик с флагом --with-bot создаёт этот файл
# в /etc/kouki/bot.env и подставляет адрес сервера и токен.
# Права: 640, владелец root:kouki.

DOTNET_ENVIRONMENT=Production

# Токен бота от @BotFather. Без него бот не стартует.
KOUKI_BOT_TOKEN=CHANGE_ME

# Куда бот ходит за приёмом задач: локальный сервер на этой же машине.
KOUKI_SERVER_URL=http://127.0.0.1:5300
# Тот же токен, что у сервера (Kouki__Token в /etc/kouki/kouki.env).
KOUKI_SERVER_TOKEN=CHANGE_ME

# Источник в базе: по нему видно, что фраза пришла из Telegram.
KOUKI_SOURCE=telegram

# Адрес Bot API (менять только для поддельного API в тестах).
KOUKI_TELEGRAM_API_URL=https://api.telegram.org
