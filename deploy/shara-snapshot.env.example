# Настройки снимков сетевой шары /srv/files (T100).
# Файл копируется в /etc/kouki/shara-snapshot.env установщиком.

# Точка монтирования шары (обязана быть смонтирована)
SRC=/srv/files

# Каталог для хранения версий со снимками
DEST=/srv/files/_backup/snapshots

# Число хранимых версий
KEEP_DAILY=7
KEEP_WEEKLY=4

# Порог возраста последней версии (в часах) для команды status
MAX_AGE_HOURS=36

# Максимальный процент диска под снимки до предупреждения
MAX_USAGE_PERCENT=10

# Файл с шаблонами исключений rsync
EXCLUDE_FILE=/etc/kouki/shara-exclude.txt

# Число случайных файлов для проверки integrity в verify
VERIFY_SAMPLES=20
