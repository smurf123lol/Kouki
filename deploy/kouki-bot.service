[Unit]
Description=Kouki Telegram bot
Documentation=file:///opt/kouki/app/deploy/README.md
# Боту нужен сервер: ждём сеть и стартуем после самого сервера.
After=network.target kouki.service
Wants=network.target
# PartOf: остановка сервера гасит и бота. Обратного действия у PartOf нет,
# поэтому после обновления сервера бота надо явно поднять — это делает
# deploy/install.sh и любой скрипт деплоя (systemctl start kouki-bot).
PartOf=kouki.service
# Предел перезапусков — в [Unit]: в [Service] systemd это ключ не знает.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=kouki
Group=kouki
WorkingDirectory=/opt/kouki/app/bot
SyslogIdentifier=kouki-bot
Environment=DOTNET_ENVIRONMENT=Production
EnvironmentFile=/etc/kouki/bot.env

ExecStart=/usr/bin/dotnet /opt/kouki/app/bot/Kouki.Kagedama.Bot.dll

Restart=on-failure
RestartSec=10
# SIGINT боту, но не бесконечно: через 20 секунд systemd добьёт процесс.
TimeoutStopSec=20
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
ReadWritePaths=/var/lib/kouki

[Install]
WantedBy=multi-user.target
