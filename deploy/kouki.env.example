# Настройки сервера Kouki. Установщик копирует этот файл в /etc/kouki/kouki.env
# и подставляет туда сгенерированный токен. Права: 640, владелец root:kouki
# (сервис читает файл как группа kouki).
#
# Переменные читаются как конфигурация .NET: вложенность — двойное подчёркивание.

# ── Публикация ────────────────────────────────────────────────────────────────
DOTNET_ENVIRONMENT=Production
# Адрес и порт. Наружу смотрит Caddy (https), поэтому сервер слушает только
# loopback: иначе его можно достать в обход прокси, по открытому http, зная токен
# из этой же машины. Если Caddy не используется (стенд, отладка) — 0.0.0.0:5300.
ASPNETCORE_URLS=http://127.0.0.1:5300

# ── Доступ ───────────────────────────────────────────────────────────────────
# Токен, с которым ходят станция, бот, MCP и дашборд. Пустое значение = API
# закрыт (fail-closed); чтобы осознанно открыть, поставьте Kouki__AllowAnonymous=true.
Kouki__Token=CHANGE_ME
Kouki__AllowAnonymous=false

# ── Пути ─────────────────────────────────────────────────────────────────────
# Только абсолютные: с Kouki__RequireAbsolutePaths=true относительный путь
# останавливает старт с объяснением, какая настройка виновата.
Kouki__RequireAbsolutePaths=true
Kouki__DatabasePath=/var/lib/kouki/db/kouki.sqlite
Kouki__AudioDirectory=/var/lib/kouki/audio
Kouki__SpeechModelDirectory=/var/lib/kouki/models/asr/sherpa-onnx-whisper-small
Kouki__AudioRetentionDays=30
# Отдельный срок для аудио, чьи фразы уже размечены: это датасет, но и
# персональные данные. 0 — не удалять (только если так решено осознанно).
Kouki__AudioLabeledRetentionDays=7

# ── Распознавание и разбор ───────────────────────────────────────────────────
Kouki__SpeechLanguage=ru
Kouki__ConfidenceThreshold=0.75
Kouki__StoreAudio=true

# ── Логи ─────────────────────────────────────────────────────────────────────
# Внимание: имена переменных для systemd не должны содержать точек, поэтому
# уровень для категории с точкой в имени здесь задать нельзя
# (`Microsoft.AspNetCore.HttpLogging` живёт в appsettings.json). Здесь — только
# категории без точек.
Logging__LogLevel__Default=Information

# ── Ограничения Kestrel ──────────────────────────────────────────────────────
# Тело запроса: голос — это WAV до 5 МБ, текст — до 2000 символов. 10 МБ
# оставляет запас и не даёт залить диск случайным дампом.
Kestrel__Limits__MaxRequestBodySize=10485760
