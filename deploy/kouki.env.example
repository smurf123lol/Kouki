# Настройки сервера Kouki. Установщик копирует этот файл в /etc/kouki/kouki.env
# и подставляет туда сгенерированный токен. Права: 600, владелец kouki:kouki.
#
# Переменные читаются как конфигурация .NET: вложенность — двойное подчёркивание.

# ── Публикация ────────────────────────────────────────────────────────────────
DOTNET_ENVIRONMENT=Production
# Адрес и порт. Наружу смотрит Caddy/прокси, поэтому слушаем все интерфейсы.
ASPNETCORE_URLS=http://0.0.0.0:5300

# ── Доступ ───────────────────────────────────────────────────────────────────
# Токен, с которым ходят станция, бот, MCP и дашборд. Пустое значение = API
# закрыт (fail-closed); чтобы осознанно открыть, поставьте Kouki__AllowAnonymous=true.
Kouki__Token=CHANGE_ME
Kouki__AllowAnonymous=false

# ── Пути ─────────────────────────────────────────────────────────────────────
# Только абсолютные: с Kouki__RequireAbsolutePaths=true относительный путь
# останавливает старт с объяснением, какая настройка виновата.
Kouki__RequireAbsolutePaths=true
Kouki__DatabasePath=/var/lib/kouki/db/kouki.sqlite
Kouki__AudioDirectory=/var/lib/kouki/audio
Kouki__SpeechModelDirectory=/var/lib/kouki/models/asr/sherpa-onnx-whisper-small
Kouki__AudioRetentionDays=30

# ── Распознавание и разбор ───────────────────────────────────────────────────
Kouki__SpeechLanguage=ru
Kouki__ConfidenceThreshold=0.75
Kouki__StoreAudio=true

# ── Логи ─────────────────────────────────────────────────────────────────────
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore.HttpLogging=Information
