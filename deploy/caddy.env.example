# Настройки https-прокси Kouki (Caddy). Установщик подставляет эти значения в
# конфиг Caddy при `install.sh --with-caddy`: отдельного файла окружения у
# systemd-юнита Caddy нет, поэтому переменные нужны именно установщику.
#
# Режимы:
#   internal — локальный CA Caddy, домен не нужен (по умолчанию);
#   acme     — публичный сертификат Let's Encrypt, нужны домен и почта.

KOUKI_HTTPS_MODE=internal

# Имя, по которому заходят люди в режиме internal (должно резолвиться на сервер).
KOUKI_SITE=kouki.local

# Только для режима acme.
KOUKI_DOMAIN=
KOUKI_ACME_EMAIL=

# Куда проксировать. Сервер слушает 127.0.0.1:5300 (ASPNETCORE_URLS в kouki.env),
# чтобы его нельзя было достать в обход Caddy.
KOUKI_UPSTREAM=127.0.0.1:5300
