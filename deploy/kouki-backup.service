[Unit]
Description=Kouki backup (SQLite snapshot + audio)
Documentation=file:///opt/kouki/app/deploy/README.md
# Бэкап читает живую базу, но не должен запускаться раньше сервера.
After=kouki.service

[Service]
Type=oneshot
User=kouki
Group=kouki
SyslogIdentifier=kouki-backup
EnvironmentFile=/etc/kouki/backup.env

ExecStart=/usr/bin/bash /opt/kouki/app/deploy/kouki-backup.sh
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
ReadWritePaths=/var/lib/kouki /var/backups/kouki
