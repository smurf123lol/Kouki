<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kouki.Kagedama</RootNamespace>
    <AssemblyName>Kouki.Kagedama</AssemblyName>

    <PackageId>Kouki.Kagedama</PackageId>
    <Description>Прикладной слой Kouki: приём задач и команды работы с ними (Кагэдама — сосуд для ядра).</Description>
    <PackageTags>kouki;tasks;intake</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Фразы команд — данные, а не код: их читает сборщик датасета (tools/Kouki.IntentDataset)
      и обучение RuBERT. Путь в [Command] задан относительно каталога приложения,
      поэтому файлы обязаны оказаться в выводе сборки. Содержимое — перенос 1:1 из
      прежнего SEED_DATA (T80), править тексты можно только осознанно: это эталонный корпус.
    -->
    <None Remove="Commands/Phrases/*.txt" />
    <Content Include="Commands/Phrases/*.txt" Link="Phrases/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kouki.Mugura\Kouki.Mugura.csproj" />
    <ProjectReference Include="..\Kouki.Yasabi\Kouki.Yasabi.csproj" />
    <ProjectReference Include="..\Kouki.Kagedama.Data\Kouki.Kagedama.Data.csproj" />
    <ProjectReference Include="..\Kouki.Kotae\Kouki.Kotae.csproj" />
    <ProjectReference Include="..\Shimi\Shimi.csproj" />
  </ItemGroup>

</Project>
