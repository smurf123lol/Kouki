<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Kouki.Un</AssemblyName>
    <RootNamespace>Kouki.Un</RootNamespace>
    <PackageId>Kouki.Un</PackageId>
    <Description>Слух Kouki: распознавание речи (муси Ун). Обёртка над sherpa-onnx; пакет подключается на этапе M4.</Description>
    <PackageTags>kouki;asr;speech;sherpa;mushi</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <!--
    sherpa-onnx подключается только по требованию (-p:KoukiEnableSherpa=true),
    чтобы обычная сборка не тянула ~200 МБ нативных библиотек.
    Папка Sherpa без пакета не компилируется вовсе.
  -->
  <ItemGroup Condition="'$(KoukiEnableSherpa)' == 'true'">
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>

  <ItemGroup Condition="'$(KoukiEnableSherpa)' != 'true'">
    <Compile Remove="Sherpa\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shimi\Shimi.csproj" />
  </ItemGroup>

</Project>
