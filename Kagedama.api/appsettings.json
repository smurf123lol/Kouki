{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information"
    }
  },
  "Kouki": {
    "DatabasePath": "kouki.sqlite",
    "RequireAbsolutePaths": false,
    "Token": "",
    "ConfidenceThreshold": 0.75,
    "StoreAudio": true,
    "AudioDirectory": "audio",
    "AudioRetentionDays": 30,
    "AudioLabeledRetentionDays": 90,
    "SpeechModelDirectory": "models",
    "SpeechLanguage": "ru",
    "SpeechVoiceDirectory": "models/tts",
    "SpeechVoice": "ru_RU-dmitri-medium",
    "SpeechMaxLoadedVoices": 2,
    "MaxVoiceBytes": 5242880,
    "MaxVoiceSeconds": 30,
    "RequestLogEnabled": true,
    "RequestLogMaxRows": 10000,
    "TagMode": "extract",
    "TagModeBySource": {},
    "FirmwareDirectory": ""
  }
}
